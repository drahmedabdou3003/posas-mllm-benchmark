# ============================================================================
# POSAS-MLLM Benchmark — API Key Template
# ============================================================================
# Copy this file to `.env` (in the project root, NOT in config/) and fill in
# the keys for the providers you want to run against. Stage 3 will skip any
# model whose env_key is not set — you do NOT need all four to run the
# pipeline; the run will simply use whichever keys are present.
# ============================================================================

# OpenAI  — GPT-5.4                      → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic  — Claude Sonnet 5           → https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google  — Gemini 3.1 Pro               → https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter  — Qwen3.7-Plus + GLM-5V    → https://openrouter.ai/keys
OPENROUTER_API_KEY=
